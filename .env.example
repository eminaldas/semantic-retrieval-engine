# extractor.py bu dosyayi ".env" olarak kopyalayip anahtarini gir.
# GOOGLE_API_KEY da kabul edilir (google-genai SDK'si GOOGLE_API_KEY'i once dener).
GEMINI_API_KEY=

# Opsiyonel: varsayilan model (gemini-flash-lite-latest) yerine baska bir model kullan.
# Dated model id'ler (orn. gemini-2.5-flash-lite) hesabina gore 404 verebilir -
# "-latest" alias'lari tercih et, ya da client.models.list() ile canli kontrol et.
# GEMINI_EXTRACTOR_MODEL=gemini-flash-lite-latest

# graph_writer.py + docker-compose.yml icin (Neo4j en az 8 karakter sifre ister).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# vector_writer.py icin. Local Docker'da API key gerekmiyor.
QDRANT_URL=http://localhost:6333

# self_correction.py icin opsiyonel model override'lari (verilmezse
# STAGE1_MODEL/DEBATE_MODEL sabitleri kullanilir).
# GEMINI_CONFLICT_CLASSIFIER_MODEL=gemini-flash-lite-latest
# GEMINI_DEBATE_MODEL=gemini-flash-latest

# dashboard.py icin opsiyonel erisim kapisi. Tanimlanmazsa dashboard korumasiz calisir.
# DASHBOARD_PASSWORD=

# MCP HTTP sunucusu (python -m backend.mcp.http_server) icin. Uzun rastgele bir deger verin;
# istemciler X-API-Key basligi ya da Bearer token olarak gonderir, OAuth giris sifresi de budur.
MCP_HTTP_TOKEN=
# Sunucu disariya (tunel/proxy) aciliyorsa genel adres; OAuth metadata'sinda kullanilir.
# MCP_PUBLIC_URL=https://rag.example.com

# Phoenix (docker compose, izleme). Uc deger de uzun rastgele olmali:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin girisi: admin@localhost / PHOENIX_ADMIN_PASSWORD (ilk acilista okunur).
PHOENIX_SECRET=
PHOENIX_ADMIN_SECRET=
PHOENIX_ADMIN_PASSWORD=
# Phoenix'te olusturulan system API key; arama/MCP izleri bununla gonderilir.
PHOENIX_API_KEY=
# Phoenix disariya (claude.ai connector) aciliyorsa genel adres.
# PHOENIX_PUBLIC_URL=https://phoenix.example.com
# Izlemeyi kapatmak icin RAG_TRACING=0; parca metinlerini span'e yazmamak icin RAG_TRACE_CONTENT=0.
# RAG_TRACE_ENDPOINT=http://localhost:6006/v1/traces
