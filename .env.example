# extractor.py bu dosyayi ".env" olarak kopyalayip anahtarini gir.
# GOOGLE_API_KEY da kabul edilir (google-genai SDK'si GOOGLE_API_KEY'i once dener).
GEMINI_API_KEY=

# Opsiyonel: varsayilan model (gemini-flash-lite-latest) yerine baska bir model kullan.
# Dated model id'ler (orn. gemini-2.5-flash-lite) hesabina gore 404 verebilir -
# "-latest" alias'lari tercih et, ya da client.models.list() ile canli kontrol et.
# GEMINI_EXTRACTOR_MODEL=gemini-flash-lite-latest

# graph_writer.py + docker-compose.yml icin (Neo4j en az 8 karakter sifre ister).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# vector_writer.py icin. Local Docker'da API key gerekmiyor.
QDRANT_URL=http://localhost:6333

# self_correction.py icin opsiyonel model override'lari (verilmezse
# STAGE1_MODEL/DEBATE_MODEL sabitleri kullanilir).
# GEMINI_CONFLICT_CLASSIFIER_MODEL=gemini-flash-lite-latest
# GEMINI_DEBATE_MODEL=gemini-flash-latest

# dashboard.py icin opsiyonel erisim kapisi. Tanimlanmazsa dashboard korumasiz calisir.
# DASHBOARD_PASSWORD=
