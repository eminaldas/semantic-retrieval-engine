{
  "_default_project": "my-project",
  "my-project": {
    "description": "Projenin spec, plan, karar ve rapor belgeleri",
    "root": "C:/path/to/my-project",
    "include": ["**/*.md"],
    "exclude": [".git/**", "**/node_modules/**", "**/.venv/**", "**/venv*/**", "**/site-packages/**"],
    "contextual": false,
    "watch": true
  },
  "_workspaces": {
    "my-workspace": {
      "description": "Bu baglantinin gorebildigi projeler",
      "projects": {"my-project": "write"},
      "home": "my-project",
      "instructions": "Workspace'e ozel kurallar (istege bagli)."
    }
  }
}
